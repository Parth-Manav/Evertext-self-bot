# =============================================================================
# Evertext Automation Framework — Environment Configuration
# Copy this file to `.env` and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# DISCORD_TOKEN (required)
# Bot token from the Discord Developer Portal → Bot → Token
# Example: DISCORD_TOKEN=MTxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxx
# -----------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here

# -----------------------------------------------------------------------------
# GUILD_ID (optional)
# Discord server (guild) ID for instant slash-command registration.
# Leave as placeholder to register commands globally (can take up to 1 hour).
# Where: Discord → Server Settings → Widget → Server ID
# -----------------------------------------------------------------------------
GUILD_ID=your_guild_id_here

# -----------------------------------------------------------------------------
# LOG_LEVEL (optional, default: INFO)
# Console verbosity: DEBUG | INFO | WARN | ERROR
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# ENCRYPTION_KEY (recommended)
# AES key for encrypting restore codes in db.json.
# Use a random 32-byte hex string. If unset or default, one is auto-generated
# on first run and appended to `.env`.
# Example: ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=default_secret_please_change

# -----------------------------------------------------------------------------
# LOG_CHANNEL_ID (optional)
# Fallback Discord channel ID for bot notifications when not set via
# /set_log_channel. Enable Developer Mode → right-click channel → Copy ID.
# -----------------------------------------------------------------------------
LOG_CHANNEL_ID=your_channel_id_here

# -----------------------------------------------------------------------------
# PORT (optional, default: 3000)
# HTTP port for the health-check server (/health, /ping).
# Used by container orchestrators (Docker, Zeabur, etc.).
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# DASHBOARD_API_KEY (optional)
# API key required to access /accounts, /jobs, /metrics, /dashboard, and /dashboard/data.
# If unset, no authentication is enforced (ideal for local development).
# Set this for secure public deployments to prevent unauthorized data exposure.
# Example: DASHBOARD_API_KEY=my_secure_secret_api_key_123
# -----------------------------------------------------------------------------
# DASHBOARD_API_KEY=

# -----------------------------------------------------------------------------
# DATABASE_URL (optional, Phase 1 PostgreSQL dual-write)
# PostgreSQL connection string for additive persistence. If unset, the bot keeps
# using db.json only and PostgreSQL writes/endpoints become no-ops.
# Docker Compose default:
# DATABASE_URL=postgres://evertext:evertext@localhost:5432/evertext
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://evertext:evertext@localhost:5432/evertext

# -----------------------------------------------------------------------------
# PostgreSQL Container Credentials (optional, defaults used for local dev)
# Change these values before deploying the docker-compose service publicly.
# If you change these, also update your DATABASE_URL to match the new values.
# -----------------------------------------------------------------------------
# POSTGRES_USER=evertext
# POSTGRES_PASSWORD=evertext
# POSTGRES_DB=evertext

# -----------------------------------------------------------------------------
# TARGET_NAME (optional, default: Terminal Service)
# Human-readable target name for logs and documentation.
# -----------------------------------------------------------------------------
TARGET_NAME=Terminal Service

# -----------------------------------------------------------------------------
# GAME_URL (required for real runs)
# Authenticated browser URL for the terminal web application.
# Example: GAME_URL=https://example.com
# -----------------------------------------------------------------------------
GAME_URL=https://example.com

# -----------------------------------------------------------------------------
# WS_BASE_URL (required for real runs)
# Engine.IO / Socket.IO WebSocket endpoint for the terminal stream.
# Example: WS_BASE_URL=wss://example.com/socket.io/?EIO=4&transport=websocket
# -----------------------------------------------------------------------------
WS_BASE_URL=wss://example.com/socket.io/?EIO=4&transport=websocket
